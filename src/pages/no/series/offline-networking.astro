---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { published,articleUrl } from '../../../lib/articles';
const entries=(await published()).filter(a=>a.data.lang==='nb'&&(a.data.series==='offline-networking'||a.data.tags.some(t=>['openwrt','wr703n','mango','pocketbox','piratebox','networking'].includes(t))||/wr703n|mango|openwrt/i.test(a.data.title)));
const roadmap=[
 ['TP-Link TL-WR703N','Dokumentere kompatibel, eldre ordinær OpenWrt etter testing på fysisk maskinvare; vurdere MikroWrt når den er klar.'],
 ['GL.iNet Mango GL-MT300N-V2','Teste kompatibel OpenWrt og PocketBox som Wi-Fi-aksesspunkt, også for tjenester på Ethernet.'],
 ['MikroWrt','Følge utviklingen av en konfigurerbar og funksjonell Linux-distribusjon for ressurssvake rutere.'],
 ['Ploos PocketBox','Dokumentere lokale Wi-Fi-tjenester på støttede MIPS-rutere når avhengigheten til MikroWrt er klar.']
];
---
<SiteLayout title="Frakoblet nettverk" lang="nb" alternateUrl="/series/offline-networking/" description="Publiserte ruterartikler og datert plan for OpenWrt, MikroWrt og Ploos PocketBox."><p class="tag">SERIE / NETTVERK</p><h1>Frakoblet nettverk</h1><p>Selvstendige Wi-Fi-nettverk, portable biblioteker og tjenester uten internett.</p><p class="muted">Plan sist gjennomgått: 23. oktober 2026. Punktene nedenfor er planer, ikke utførte laboratorietester.</p><h2>Aktuelle undersøkelser</h2><ol>{roadmap.map(([name,description])=><li><strong>{name}</strong> — {description} <span class="muted">(maskinvaretesting gjenstår)</span></li>)}</ol><h2>Historiske prosjekter</h2><p>PirateBox og LibraryBox er nedlagt oppstrøms. Vi beholder arkivforskningen, men planlegger ikke nye installasjonsguider eller porteringer med mindre installasjonsfiler kan gjenfinnes og testes på fysisk maskinvare.</p><h2>Forskningsutkast</h2><p>Artiklene om maskinvarerevisjon og eldre OpenWrt-installasjon på TL-WR703N er fortsatt <strong>upubliserte utkast</strong>. Maskinvare- og gjenopprettingskravene må verifiseres før publisering. Utkastene er ikke installasjonsveiledninger.</p><h2>Publiserte artikler</h2>{entries.length ? <ul>{entries.map(a=><li><a href={articleUrl(a.id,'nb')}>{a.data.title}</a></li>)}</ul> : <p class="muted">Tekniske artikler er under arbeid.</p>}</SiteLayout>
