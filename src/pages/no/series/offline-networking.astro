---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { published,articleUrl } from '../../../lib/articles';
const entries=(await published()).filter(a=>a.data.lang==='nb'&&a.data.series==='offline-networking');
const roadmap=['PirateBox på TP-Link TL-WR703N','LibraryBox på TP-Link TL-WR703N','Portere PirateBox til GL.iNet Mango','Portere LibraryBox til GL.iNet Mango','Ploos PocketBox på MIPS-rutere'];
---
<SiteLayout title="Offline Networking" lang="nb"><p class="tag">SERIE / NETTVERK</p><h1>Offline Networking</h1><p>Selvstendige Wi-Fi-nettverk, portable biblioteker og tjenester uten internett.</p><h2>Planlagte undersøkelser</h2><ol>{roadmap.map(item=><li>{item} <span class="muted">— planlagt; maskinvaretesting gjenstår</span></li>)}</ol><h2>Publiserte artikler</h2>{entries.length ? <ul>{entries.map(a=><li><a href={articleUrl(a.id,'nb')}>{a.data.title}</a></li>)}</ul> : <p class="muted">Tekniske artikler er under arbeid.</p>}</SiteLayout>
