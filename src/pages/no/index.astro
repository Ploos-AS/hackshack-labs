---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { published, articleUrl, categoryLabelsNo } from '../../lib/articles';
const recent=(await published()).filter(a=>a.data.lang==='nb').slice(0,5);
const sections=Object.keys(categoryLabelsNo);
---
<SiteLayout title="Utforsk · Bygg · Hack" lang="nb"><section class="hero"><p class="tag">root@hackshack:~$ ls projects/</p><h1>Utforsk. Bygg. Hack.</h1><p>Praktiske prosjekter, grundige guider, maskinvareanmeldelser og etterprøvbare tester.</p><p class="muted">Første serie: PirateBox → LibraryBox → PocketBox.</p></section><h2 id="topics">Utforsk laboratoriet</h2><div class="grid">{sections.map(s => <article class="card"><span class="tag">[ {categoryLabelsNo[s].toUpperCase()} ]</span><h3><a href={`/no/category/${s}/`}>{categoryLabelsNo[s]}</a></h3><p class="muted">Se artikler og ressurser.</p></article>)}</div><h2>Siste artikler</h2><div class="grid">{recent.map(a=><article class="card"><h3><a href={articleUrl(a.id,'nb')}>{a.data.title}</a></h3><p class="muted">{a.data.description}</p></article>)}</div></SiteLayout>
