---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { published, articleUrl, categoryLabelsNo } from '../../lib/articles';
const articles=(await published()).filter(a=>a.data.lang==='nb');
const recent=articles.slice(0,8);
const sections=[...new Set(articles.map(a=>a.data.category))];
---
<SiteLayout title="Uavhengige teknologiguider og undersøkelser" lang="nb" alternateUrl="/"><section class="hero"><p class="tag">root@hackshack:~$ ls projects/</p><h1>Utforsk. Bygg. Hack.</h1><p>Uavhengige dokumentasjonsbaserte guider og tekniske undersøkelser. Praktiske maskinvaretester er planlagt og vil merkes tydelig når de er gjennomført.</p><p class="muted">Aktuelle temaer: OpenWrt, MikroWrt, PocketBox, personvern og amatørradio / SDR.</p><p><a href="/no/series/ham-radio-sdr/">Utforsk amatørradio og SDR →</a></p></section><h2 id="topics">Utforsk laboratoriet</h2><div class="grid">{sections.map(s => <article class="card"><span class="tag">[ {categoryLabelsNo[s].toUpperCase()} ]</span><h3><a href={`/no/category/${s}/`}>{categoryLabelsNo[s]}</a></h3><p class="muted">{articles.filter(a=>a.data.category===s).length} publiserte artikler i kategorien.</p></article>)}</div><h2>Siste artikler</h2><div class="grid">{recent.map(a=><article class="card"><p class="tag">{a.data.date.toLocaleDateString("nb-NO",{day:"numeric",month:"short",year:"numeric"})} · {categoryLabelsNo[a.data.category]} · {a.data.tested ? "Maskinvareverifisert" : "Dokumentasjonsbasert"}</p><h3><a href={articleUrl(a.id,'nb')}>{a.data.title}</a></h3><p class="muted">{a.data.description}</p></article>)}</div></SiteLayout>
