---
import { render } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { published, articleUrl, categoryLabelsNo } from '../../../lib/articles';
export async function getStaticPaths(){
  const entries=(await published()).filter(a=>a.data.lang==='nb');
  return entries.map(entry=>({params:{slug:entry.id.split('/').at(-1)},props:{entry}}));
}
const {entry}=Astro.props;
const {Content}=await render(entry);
const all=await published();
const counterpart=all.find(a=>a.data.lang==='en' && a.data.translationKey && a.data.translationKey===entry.data.translationKey);
---
<SiteLayout title={entry.data.title} lang="nb" alternateUrl={counterpart ? articleUrl(counterpart.id,'en') : undefined}>
  <article><p class="tag">{categoryLabelsNo[entry.data.category]} · {entry.data.date.toLocaleDateString('nb-NO')} · {entry.data.tested ? 'Maskinvareverifisert' : 'Dokumentasjonsbasert'}</p><h1>{entry.data.title}</h1><p class="muted">{entry.data.description}</p><Content /></article>
</SiteLayout>
