---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { published, articleUrl, categoryLabelsNo } from '../../lib/articles';
const articles=(await published()).filter(a=>a.data.lang==='nb').map(a=>({title:a.data.title,description:a.data.description,category:categoryLabelsNo[a.data.category],tags:a.data.tags,url:articleUrl(a.id,'nb')}));
---
<SiteLayout title="Søk" lang="nb"><h1>Søk i laboratoriet</h1><label for="q">Søk i artikler</label><input id="q" type="search" placeholder="Tittel, emneknagger, beskrivelse…" autocomplete="off"/><p id="count" aria-live="polite"></p><div id="results" class="grid"></div><script type="application/json" id="article-index" set:html={JSON.stringify(articles).replace(/</g,'\\u003c')}/><script>const data=JSON.parse(document.querySelector('#article-index')?.textContent||'[]');const input=document.querySelector('#q');const results=document.querySelector('#results');const count=document.querySelector('#count');function show(){if(!(input instanceof HTMLInputElement)||!results||!count)return;const q=input.value.toLocaleLowerCase().trim();const matches=data.filter((a:{title:string;description:string;category:string;tags:string[];url:string})=>!q||[a.title,a.description,a.category,...a.tags].join(' ').toLocaleLowerCase().includes(q));results.replaceChildren();for(const a of matches){const card=document.createElement('article');card.className='card';const link=document.createElement('a');link.href=a.url;link.textContent=a.title;const desc=document.createElement('p');desc.className='muted';desc.textContent=a.description;card.append(link,desc);results.append(card)}count.textContent=`${matches.length} treff`;}input?.addEventListener('input',show);show();</script></SiteLayout>
