---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { published,articleUrl } from '../../lib/articles';
const entries=(await published()).filter(a=>a.data.lang==='en'&&a.data.series==='offline-networking');
const roadmap=['PirateBox on TP-Link TL-WR703N','LibraryBox on TP-Link TL-WR703N','PirateBox port to GL.iNet Mango','LibraryBox port to GL.iNet Mango','Ploos PocketBox on MIPS routers'];
---
<SiteLayout title="Offline Networking"><p class="tag">SERIES / NETWORKING</p><h1>Offline Networking</h1><p>Self-contained Wi-Fi networks, portable libraries and services without Internet access.</p><h2>Planned investigations</h2><ol>{roadmap.map(item=><li>{item} <span class="muted">— planned; hardware verification pending</span></li>)}</ol><h2>Published articles</h2>{entries.length ? <ul>{entries.map(a=><li><a href={articleUrl(a.id,'en')}>{a.data.title}</a></li>)}</ul> : <p class="muted">Technical articles are being prepared.</p>}</SiteLayout>
