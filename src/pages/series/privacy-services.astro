---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { published, articleUrl, evidenceLabel } from '../../lib/articles';
const order=["proton-ecosystem-overview","tuta-vs-proton-2026","proton-mail-vs-self-hosted-email","proton-drive-docs-vs-nextcloud","password-managers-proton-bitwarden-vaultwarden-keepassxc-2026","proton-vpn-linux-docker-gluetun"];
const all=(await published()).filter(a=>a.data.lang==='en');
const entries=order.map(slug=>all.find(a=>a.id.split('/').at(-1)===slug)).filter(Boolean);
---
<SiteLayout title="Privacy Services & Digital Independence" lang="en" alternateUrl="/no/series/privacy-services/" description="A curated reading path with clear evidence labels and source-based comparisons.">
<p class="tag">SERIES / GUIDES</p><h1>Privacy Services & Digital Independence</h1>
<p>Suggested reading order. Check each article's evidence level and recheck time-sensitive details before purchasing.</p><ol>{entries.map(a=><li><a href={articleUrl(a.id,'en')}>{a.data.title}</a> <span class="muted">· {evidenceLabel(a.data,'en')}</span><p>{a.data.description}</p></li>)}</ol>
<p class="muted">Prices, availability and platform features may change.</p>
</SiteLayout>
