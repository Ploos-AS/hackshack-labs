---
import SiteLayout from '../layouts/SiteLayout.astro';
import { published, articleUrl, categoryLabels } from '../lib/articles';
const articles=(await published()).filter(a=>a.data.lang==='en');
const recent=articles.slice(0,8);
const sections = [...new Set(articles.map(a=>a.data.category))];
---
<SiteLayout title="Independent Technology Guides & Research" alternateUrl="/no/"><section class="hero"><p class="tag">root@hackshack:~$ ls projects/</p><h1>Explore. Build. Hack.</h1><p>Independent documentation-based guides and technical research. Hands-on hardware tests are planned and will be clearly identified when completed.</p><p class="muted">Current labs: OpenWrt, MikroWrt, PocketBox, privacy and ham radio / SDR.</p><p><a href="/series/ham-radio-sdr/">Explore Ham Radio &amp; SDR →</a></p></section><h2 id="topics">Explore the lab</h2><div class="grid">{sections.map(s => <article class="card"><span class="tag">[ {categoryLabels[s].toUpperCase()} ]</span><h3><a href={`/category/${s}/`}>{categoryLabels[s]}</a></h3><p class="muted">{articles.filter(a=>a.data.category===s).length} published article(s) in this category.</p></article>)}</div><h2>Latest articles</h2><div class="grid">{recent.map(a=><article class="card"><p class="tag">{a.data.date.toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"})} · {categoryLabels[a.data.category]} · {a.data.tested ? "Hardware verified" : "Documentation-based"}</p><h3><a href={articleUrl(a.id,'en')}>{a.data.title}</a></h3><p class="muted">{a.data.description}</p></article>)}</div></SiteLayout>
