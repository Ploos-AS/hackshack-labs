---
import SiteLayout from '../layouts/SiteLayout.astro';
import { published, articleUrl, categoryLabels } from '../lib/articles';
const recent=(await published()).filter(a=>a.data.lang==='en').slice(0,5);
const sections = Object.keys(categoryLabels);
---
<SiteLayout title="Explore · Build · Hack"><!-- Impact-Site-Verification: e33f643d-73f3-4668-831d-cfe8daa1e432 --><section class="hero"><p class="tag">root@hackshack:~$ ls projects/</p><h1>Explore. Build. Hack.</h1><p>Hands-on projects, thorough guides, hardware reviews and reproducible tests.</p><p class="muted">Current labs: OpenWrt, MikroWrt, PocketBox, privacy and ham radio / SDR.</p><p><a href="/series/ham-radio-sdr/">Explore Ham Radio &amp; SDR →</a></p></section><h2 id="topics">Explore the lab</h2><div class="grid">{sections.map(s => <article class="card"><span class="tag">[ {categoryLabels[s].toUpperCase()} ]</span><h3><a href={`/category/${s}/`}>{categoryLabels[s]}</a></h3><p class="muted">Browse articles and resources.</p></article>)}</div><h2>Latest articles</h2><div class="grid">{recent.map(a=><article class="card"><h3><a href={articleUrl(a.id,'en')}>{a.data.title}</a></h3><p class="muted">{a.data.description}</p></article>)}</div></SiteLayout>
