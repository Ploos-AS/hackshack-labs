---
import SiteLayout from '../layouts/SiteLayout.astro';
const sections = ['Projects','Guides','How-Tos','Mini How-Tos','Reviews','Tests','Tutorials','Deep Dives','Teardowns','Experiments','Reference'];
---
<SiteLayout title="Explore · Build · Hack"><section class="hero"><p class="tag">root@hackshack:~$ ls projects/</p><h1>Explore. Build. Hack.</h1><p>Hands-on projects, thorough guides, hardware reviews and reproducible tests.</p><p class="muted">Coming first: PirateBox → LibraryBox → PocketBox.</p></section><h2 id="topics">Explore the lab</h2><div class="grid">{sections.map(s => <article class="card"><span class="tag">[ {s.toUpperCase()} ]</span><h3>{s}</h3><p class="muted">Articles and resources are being prepared.</p></article>)}</div></SiteLayout>
