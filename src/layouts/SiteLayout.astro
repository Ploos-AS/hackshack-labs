---
import '../styles/global.css';
const { title = 'HackShack Labs', lang = 'en', alternateUrl } = Astro.props;
const no = lang === 'nb';
const sections = [['Projects','projects'],['Guides','guides'],['How-Tos','how-tos'],['Mini How-Tos','mini-how-tos'],['Reviews','reviews'],['Tests','tests']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#080d0a"/><title>{title} | HackShack Labs</title>{alternateUrl && <link rel="alternate" hreflang={no ? "en" : "nb"} href={new URL(alternateUrl, Astro.site).href}/>}<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href}/></head><body>
<header><div class="wrap"><a class="brand" href="/">HACKSHACK_ LABS</a><nav aria-label="Main navigation">{sections.map(([label,slug]) => <a href={`${no ? '/no' : ''}/category/${slug}/`}>{label}</a>)}<a href={no ? '/no/search/' : '/search/'}>{no ? 'Søk' : 'Search'}</a><a href={no ? '/no/series/offline-networking/' : '/series/offline-networking/'}>Offline Networking</a><a href={alternateUrl ?? (no ? '/' : '/no/')} lang={no ? 'en' : 'nb'}>{no ? 'EN' : 'NO'}</a></nav></div></header>
<main class="wrap"><slot/></main><footer><div class="wrap muted">Ploos AS · Open technology, practical knowledge.</div></footer></body></html>
