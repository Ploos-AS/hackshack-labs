---
import '../styles/global.css';
const { title = 'HackShack Labs', lang = 'en', alternateUrl, hideLanguageSwitch = false, description, image, pageType = 'website' } = Astro.props;
const no = lang === 'nb';
const metaDescription = description ?? (no ? 'Uavhengige teknologiguider og dokumentasjonsbaserte undersøkelser fra HackShack Labs.' : 'Independent, documentation-based technology guides and research from HackShack Labs.');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternate = alternateUrl ? new URL(alternateUrl, Astro.site).href : undefined;
const sections = [['Projects','Prosjekter','projects'],['Guides','Guider','guides'],['Reference','Oppslagsverk','reference'],['Deep Dives','Dybdeanalyser','deep-dives']];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#080d0a"/><meta name="verification" content="853bfbdfd067940232597557c82fcec2" /><meta name="description" content={metaDescription}/><meta property="og:title" content={`${title} | HackShack Labs`}/><meta property="og:description" content={description}/><meta property="og:type" content={pageType}/><meta property="og:url" content={canonical}/>{image && <meta property="og:image" content={new URL(image, Astro.site).href}/>}<meta name="twitter:card" content="summary"/><link rel="alternate" type="application/rss+xml" title="HackShack Labs RSS" href="/rss.xml"/><title>{title} | HackShack Labs</title><link rel="alternate" hreflang={no ? "nb" : "en"} href={canonical}/>{alternate && <link rel="alternate" hreflang={no ? "en" : "nb"} href={alternate}/>}<link rel="canonical" href={canonical}/></head><body>
<header><div class="wrap"><a class="brand" href={no ? "/no/" : "/"}>HACKSHACK_ LABS</a><nav aria-label="Main navigation">{sections.map(([english,norwegian,slug]) => <a href={`${no ? '/no' : ''}/category/${slug}/`}>{no ? norwegian : english}</a>)}<a href={no ? '/no/search/' : '/search/'}>{no ? 'Søk' : 'Search'}</a><a href={no ? '/no/series/offline-networking/' : '/series/offline-networking/'}>{no ? 'Frakoblet nettverk' : 'Offline Networking'}</a><a href={no ? '/no/series/ham-radio-sdr/' : '/series/ham-radio-sdr/'}>{no ? 'Amatørradio & SDR' : 'Ham Radio & SDR'}</a>{!hideLanguageSwitch && <a href={alternateUrl ?? (no ? '/' : '/no/')} lang={no ? 'en' : 'nb'} title={alternateUrl ? undefined : (no ? "English home" : "Norsk forside")}>{no ? 'EN' : 'NO'}</a>}</nav></div></header>
<main class="wrap"><slot/></main><footer><div class="wrap muted">Ploos AS · Open technology, practical knowledge. · <a href={no ? "/no/about/" : "/about/"}>{no ? "Om oss og redaksjonell policy" : "About & editorial policy"}</a> · <a href="/rss.xml">RSS</a> · <a href={no ? "/no/privacy/" : "/privacy/"}>{no ? "Personvern" : "Privacy"}</a></div></footer></body></html>
