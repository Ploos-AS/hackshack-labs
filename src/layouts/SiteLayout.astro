---
import '../styles/global.css';
const { title = 'HackShack Labs', lang = 'en' } = Astro.props;
const no = lang === 'nb';
const sections = ['Projects','Guides','How-Tos','Mini How-Tos','Reviews','Tests'];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#080d0a"/><title>{title} | HackShack Labs</title><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href}/></head><body>
<header><div class="wrap"><a class="brand" href="/">HACKSHACK_ LABS</a><nav aria-label="Main navigation">{sections.map(s => <a href={no ? '/no/#topics' : '/#topics'}>{s}</a>)}<a href={no ? '/' : '/no/'} lang={no ? 'en' : 'nb'}>{no ? 'EN' : 'NO'}</a></nav></div></header>
<main class="wrap"><slot/></main><footer><div class="wrap muted">Ploos AS · Open technology, practical knowledge.</div></footer></body></html>
