# COPY TO .env LOCALLY; NEVER COMMIT .env
# Replace placeholders with the complete repository@sha256 digest from docker image inspect.
GLUETUN_IMAGE=qmcgaw/gluetun@sha256:REPLACE_WITH_REAL_DIGEST
NETSHOOT_IMAGE=nicolaka/netshoot@sha256:REPLACE_WITH_REAL_DIGEST
# Use a Proton-generated WireGuard private key. Do not paste it in issue reports.
WIREGUARD_PRIVATE_KEY=REPLACE_LOCALLY
